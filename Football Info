<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Football Info - Your Complete Football Archive</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800;900&family=Anton&family=Big+Shoulders+Display:wght@600;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --void: #0a0a0d;
            --pitch-dark: #062218;
            --pitch: #0e3f2b;
            --gold: #d4af37;
            --gold-bright: #f4d35e;
            --gold-2: #ffd166;
            --cream: #f3ead9;
            --chalk: #fbf7ec;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--cream);
            background-color: var(--void);
            min-height: 100vh;
            padding: 20px;
            transition: all 0.3s ease;
        }

        /* Navigation Bar */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(10, 10, 13, 0.95);
            backdrop-filter: blur(10px);
            padding: 15px 20px;
            display: flex;
            justify-content: flex-start;
            align-items: center;
            gap: 10px;
            overflow-x: auto;
            white-space: nowrap;
            scrollbar-width: thin;
            z-index: 1000;
            border-bottom: 2px solid rgba(212, 175, 55, 0.2);
        }

        .nav-btn {
            background: none;
            border: none;
            color: var(--chalk);
            font-size: 1.1em;
            font-weight: 600;
            cursor: pointer;
            padding: 8px 20px;
            border-radius: 8px;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.9em;
        }

        .nav-btn:hover {
            background: rgba(212, 175, 55, 0.1);
            color: var(--gold-bright);
        }

        .nav-btn.active {
            background: rgba(212, 175, 55, 0.25);
            color: var(--gold-bright);
            border-bottom: 3px solid var(--gold-bright);
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            margin-top: 80px;
            position: relative;
            z-index: 2;
        }

        /* HOME PAGE STYLES */
        .page {
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .page.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .home-page {
            text-align: center;
            padding: 60px 20px;
            background: radial-gradient(ellipse 900px 520px at 50% -8%, rgba(212, 175, 55, 0.20), transparent 60%),
                        radial-gradient(ellipse 700px 460px at 100% 100%, rgba(212, 175, 55, 0.09), transparent 65%);
        }

        .home-page h1 {
            font-family: 'Playfair Display', serif;
            font-weight: 900;
            font-size: clamp(3em, 10vw, 5em);
            background: linear-gradient(180deg, #fbeec2 0%, var(--gold-bright) 35%, var(--gold) 65%, var(--gold-2) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            filter: drop-shadow(0 2px 18px rgba(212, 175, 55, 0.35));
            margin-bottom: 20px;
            letter-spacing: 2px;
        }

        .home-page p {
            font-size: 1.3em;
            color: var(--gold-2);
            margin-bottom: 60px;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 500;
        }

        .sections {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-top: 40px;
        }

        /* UCL PAGE STYLES */
        .ucl-page {
            background: linear-gradient(-45deg, #1c0805 0%, #2b0f08 25%, #1f0a04 50%, #2b0f08 75%, #1c0805 100%);
            background-size: 400% 400%;
            animation: uclEnergeticShift 8s ease infinite;
            padding: 60px 20px;
            position: relative;
            overflow: hidden;
        }

        @keyframes uclEnergeticShift {
            0% { 
                background-position: 0% 50%;
                background: linear-gradient(-45deg, #1c0805 0%, #2b0f08 25%, #1f0a04 50%, #2b0f08 75%, #1c0805 100%);
            }
            25% { 
                background: linear-gradient(-45deg, #2b0f08 0%, #1f0a04 25%, #2b0f08 50%, #1c0805 75%, #2b0f08 100%);
            }
            50% { 
                background: linear-gradient(-45deg, #1f0a04 0%, #2b0f08 25%, #1c0805 50%, #1f0a04 75%, #2b0f08 100%);
            }
            75% { 
                background: linear-gradient(-45deg, #2b0f08 0%, #1c0805 25%, #2b0f08 50%, #1f0a04 75%, #1c0805 100%);
            }
            100% { 
                background-position: 100% 50%;
                background: linear-gradient(-45deg, #1c0805 0%, #2b0f08 25%, #1f0a04 50%, #2b0f08 75%, #1c0805 100%);
            }
        }

        .ucl-page::before {
            content: '';
            position: fixed;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: url('ucl-trophy.png') center/contain no-repeat;
            opacity: 0.06;
            pointer-events: none;
            z-index: 0;
            animation: uclRotate 30s linear infinite;
        }

        @keyframes uclRotate {
            0% { transform: rotate(0deg) scale(1); }
            100% { transform: rotate(360deg) scale(1); }
        }

        .ucl-page::after {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(circle at 20% 80%, rgba(255, 157, 63, 0.2) 0%, transparent 40%),
                radial-gradient(circle at 80% 20%, rgba(255, 209, 102, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, rgba(255, 100, 0, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 30% 30%, rgba(214, 84, 42, 0.15) 0%, transparent 40%);
            pointer-events: none;
            z-index: 1;
            animation: uclEnergeticPulse 6s ease-in-out infinite;
        }

        @keyframes uclEnergeticPulse {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }

        .ucl-page h1 {
            font-family: 'Playfair Display', serif;
            font-weight: 900;
            font-size: clamp(3em, 10vw, 5em);
            background: linear-gradient(180deg, #ff9d3f 0%, #ffb35c 25%, #e8590c 50%, #d1263d 75%, #ff9d3f 100%);
            background-size: 200% 200%;
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            filter: drop-shadow(0 0 20px rgba(255, 157, 63, 0.5)) drop-shadow(0 0 40px rgba(209, 38, 61, 0.3));
            margin-bottom: 20px;
            letter-spacing: 2px;
            text-align: center;
            animation: uclTextGlow 3s ease-in-out infinite;
            position: relative;
            z-index: 2;
        }

        @keyframes uclTextGlow {
            0%, 100% { filter: drop-shadow(0 0 20px rgba(255, 157, 63, 0.5)) drop-shadow(0 0 40px rgba(209, 38, 61, 0.3)); }
            50% { filter: drop-shadow(0 0 30px rgba(255, 157, 63, 0.8)) drop-shadow(0 0 60px rgba(209, 38, 61, 0.5)); }
        }

        .ucl-page p {
            font-size: 1.3em;
            background: linear-gradient(90deg, #ff9d3f, #ffc178, #ffe0b3);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 60px;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 600;
            text-align: center;
            animation: uclSubPulse 2s ease-in-out infinite;
            position: relative;
            z-index: 2;
        }

        @keyframes uclSubPulse {
            0%, 100% { opacity: 0.8; }
            50% { opacity: 1; }
        }

        /* UCL Search Section */
        .ucl-search-section {
            display: flex;
            gap: 15px;
            margin-bottom: 40px;
            flex-wrap: wrap;
            justify-content: center;
            position: relative;
            z-index: 2;
        }

        .ucl-search-input,
        .ucl-search-filter {
            padding: 14px 24px;
            font-size: 1em;
            font-family: 'Inter', sans-serif;
            border: 2px solid rgba(255, 157, 63, 0.5);
            background: linear-gradient(135deg, rgba(0, 20, 60, 0.8), rgba(10, 30, 80, 0.8));
            color: #ffe0b3;
            border-radius: 10px;
            transition: all 0.3s ease;
            box-shadow: 0 0 15px rgba(255, 157, 63, 0.2),
                        inset 0 0 10px rgba(255, 157, 63, 0.05);
        }

        .ucl-search-input::placeholder {
            color: rgba(164, 245, 255, 0.5);
        }

        .ucl-search-input:focus,
        .ucl-search-filter:focus {
            outline: none;
            border-color: #ff9d3f;
            background: linear-gradient(135deg, rgba(0, 40, 100, 0.9), rgba(20, 50, 120, 0.9));
            box-shadow: 0 0 25px rgba(255, 157, 63, 0.4),
                        inset 0 0 15px rgba(255, 157, 63, 0.1);
            color: #ff9d3f;
        }

        .ucl-search-btn {
            padding: 14px 40px;
            background: linear-gradient(135deg, #ff9d3f, #d1263d);
            border: 2px solid rgba(255, 157, 63, 0.6);
            color: #fff;
            font-weight: 700;
            border-radius: 10px;
            cursor: pointer;
            font-size: 1em;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            box-shadow: 0 0 20px rgba(255, 157, 63, 0.3),
                        0 0 40px rgba(209, 38, 61, 0.2);
        }

        .ucl-search-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 0 30px rgba(255, 157, 63, 0.5),
                        0 0 60px rgba(209, 38, 61, 0.4);
            background: linear-gradient(135deg, #ffb35c, #ff3355);
        }

        .ucl-search-btn:active {
            transform: translateY(-1px);
        }

        .ucl-search-results {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 30px;
            position: relative;
            z-index: 2;
        }

        .ucl-result-card {
            background: linear-gradient(135deg, rgba(255, 157, 63, 0.1), rgba(209, 38, 61, 0.08));
            border: 2px solid rgba(255, 157, 63, 0.4);
            border-radius: 15px;
            padding: 25px;
            cursor: pointer;
            transition: all 0.4s ease;
            box-shadow: 0 0 20px rgba(255, 157, 63, 0.2),
                        inset 0 0 15px rgba(255, 157, 63, 0.05);
            animation: slideUp 0.5s ease forwards;
        }

        .ucl-result-card:hover {
            transform: translateY(-8px);
            border-color: #ff9d3f;
            background: linear-gradient(135deg, rgba(255, 157, 63, 0.15), rgba(209, 38, 61, 0.12));
            box-shadow: 0 0 35px rgba(255, 157, 63, 0.4),
                        inset 0 0 20px rgba(255, 157, 63, 0.1);
        }

        .ucl-result-year {
            font-family: 'Playfair Display', serif;
            font-size: 2.5em;
            font-weight: 900;
            background: linear-gradient(135deg, #ff9d3f, #d1263d);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 15px;
            filter: drop-shadow(0 0 10px rgba(255, 157, 63, 0.4));
        }

        .ucl-result-info {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .ucl-result-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255, 157, 63, 0.2);
        }

        .ucl-result-row:last-child {
            border-bottom: none;
        }

        .ucl-result-label {
            color: #ffc178;
            font-weight: 600;
            font-size: 0.9em;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .ucl-result-value {
            color: #ffe0b3;
            font-weight: 700;
            font-size: 1em;
        }

        .ucl-no-results {
            grid-column: 1 / -1;
            text-align: center;
            padding: 40px 20px;
            color: #ffc178;
            font-size: 1.1em;
            background: linear-gradient(135deg, rgba(255, 157, 63, 0.08), rgba(209, 38, 61, 0.05));
            border: 2px dashed rgba(255, 157, 63, 0.3);
            border-radius: 15px;
            letter-spacing: 1px;
        }

        .ucl-timeline {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding: 20px 0;
            margin: 40px 0;
            scroll-behavior: smooth;
            justify-content: flex-start;
            position: relative;
            z-index: 2;
        }

        .ucl-timeline::-webkit-scrollbar {
            height: 8px;
        }

        .ucl-timeline::-webkit-scrollbar-track {
            background: rgba(255, 157, 63, 0.1);
            border-radius: 10px;
        }

        .ucl-timeline::-webkit-scrollbar-thumb {
            background: linear-gradient(90deg, #ff9d3f, #d1263d);
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(255, 157, 63, 0.4);
        }

        .ucl-yr-btn {
            background: rgba(255, 157, 63, 0.08);
            border: 2px solid rgba(255, 157, 63, 0.3);
            color: #ffc178;
            padding: 12px 20px;
            border-radius: 10px;
            cursor: pointer;
            font-size: 0.95em;
            font-weight: 600;
            white-space: nowrap;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            box-shadow: 0 0 10px rgba(255, 157, 63, 0.1);
        }

        .ucl-yr-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 157, 63, 0.2), transparent);
            transition: left 0.5s ease;
        }

        .ucl-yr-btn:hover {
            border-color: #ff9d3f;
            background: rgba(255, 157, 63, 0.15);
            color: #ffe0b3;
            box-shadow: 0 0 20px rgba(255, 157, 63, 0.3);
            transform: translateY(-2px);
        }

        .ucl-yr-btn:hover::before {
            left: 100%;
        }

        .ucl-yr-btn.active {
            background: linear-gradient(135deg, rgba(255, 157, 63, 0.3), rgba(209, 38, 61, 0.2));
            border-color: #ff9d3f;
            color: #ffe0b3;
            box-shadow: 0 0 25px rgba(255, 157, 63, 0.5), inset 0 0 10px rgba(255, 157, 63, 0.1);
            text-shadow: 0 0 10px rgba(255, 157, 63, 0.4);
        }

        .ucl-board {
            background: linear-gradient(135deg, rgba(10, 30, 80, 0.8), rgba(5, 20, 60, 0.8));
            border: 2px solid rgba(255, 157, 63, 0.5);
            border-radius: 20px;
            padding: 50px;
            margin-top: 40px;
            animation: fadeIn 0.5s ease;
            position: relative;
            z-index: 2;
            box-shadow: 0 0 30px rgba(255, 157, 63, 0.2),
                        inset 0 0 30px rgba(255, 157, 63, 0.05),
                        0 0 60px rgba(209, 38, 61, 0.15);
        }

        .ucl-board::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            border-radius: 20px;
            background: radial-gradient(circle at 20% 80%, rgba(255, 157, 63, 0.1) 0%, transparent 50%),
                        radial-gradient(circle at 80% 20%, rgba(209, 38, 61, 0.08) 0%, transparent 50%);
            pointer-events: none;
            animation: uclBoardShine 4s ease-in-out infinite;
        }

        @keyframes uclBoardShine {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 1; }
        }

        .ucl-board-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 2px solid rgba(255, 157, 63, 0.2);
        }

        .ucl-board-year {
            font-family: 'Playfair Display', serif;
            font-size: 3.5em;
            font-weight: 900;
            background: linear-gradient(180deg, #ff9d3f 0%, #ffc178 50%, #d1263d 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            filter: drop-shadow(0 0 15px rgba(255, 157, 63, 0.6)) drop-shadow(0 0 30px rgba(209, 38, 61, 0.4));
            text-shadow: 0 0 20px rgba(255, 157, 63, 0.3);
            animation: uclYearPulse 2s ease-in-out infinite;
        }

        @keyframes uclYearPulse {
            0%, 100% { filter: drop-shadow(0 0 15px rgba(255, 157, 63, 0.6)) drop-shadow(0 0 30px rgba(209, 38, 61, 0.4)); }
            50% { filter: drop-shadow(0 0 25px rgba(255, 157, 63, 0.9)) drop-shadow(0 0 50px rgba(209, 38, 61, 0.6)); }
        }

        .ucl-board-host {
            color: #ffc178;
            font-size: 1.1em;
            letter-spacing: 1px;
        }

        .ucl-podium {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
            margin-bottom: 40px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .ucl-podium-slot {
            border-radius: 15px;
            padding: 40px 30px;
            text-align: center;
            border: 2px solid;
            transition: all 0.3s ease;
            animation: slideUp 0.6s ease forwards;
            position: relative;
            overflow: hidden;
        }

        .ucl-podium-slot::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            animation: uclShine 3s ease-in-out infinite;
        }

        @keyframes uclShine {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(100px, 100px); }
        }

        .ucl-podium-slot.gold {
            background: linear-gradient(135deg, rgba(255, 157, 63, 0.25), rgba(209, 38, 61, 0.15));
            border-color: #ff9d3f;
            box-shadow: 0 0 30px rgba(255, 157, 63, 0.4),
                        inset 0 0 20px rgba(255, 157, 63, 0.1),
                        0 0 60px rgba(255, 157, 63, 0.2);
            transform: scale(1.08);
            animation: uclGlowPulse 2s ease-in-out infinite, slideUp 0.6s ease forwards;
        }

        @keyframes uclGlowPulse {
            0%, 100% { 
                box-shadow: 0 0 30px rgba(255, 157, 63, 0.4),
                            inset 0 0 20px rgba(255, 157, 63, 0.1),
                            0 0 60px rgba(255, 157, 63, 0.2);
            }
            50% { 
                box-shadow: 0 0 50px rgba(255, 157, 63, 0.7),
                            inset 0 0 30px rgba(255, 157, 63, 0.2),
                            0 0 80px rgba(255, 157, 63, 0.4);
            }
        }

        .ucl-podium-slot.silver {
            background: linear-gradient(135deg, rgba(209, 38, 61, 0.2), rgba(0, 150, 255, 0.15));
            border-color: #d1263d;
            box-shadow: 0 0 20px rgba(209, 38, 61, 0.3),
                        inset 0 0 15px rgba(209, 38, 61, 0.08);
            animation: uclSecondaryGlow 2s ease-in-out infinite, slideUp 0.6s ease forwards 0.1s;
        }

        @keyframes uclSecondaryGlow {
            0%, 100% { 
                box-shadow: 0 0 20px rgba(209, 38, 61, 0.3),
                            inset 0 0 15px rgba(209, 38, 61, 0.08);
            }
            50% { 
                box-shadow: 0 0 35px rgba(209, 38, 61, 0.5),
                            inset 0 0 25px rgba(209, 38, 61, 0.15);
            }
        }

        .ucl-medal {
            font-size: 0.9em;
            background: linear-gradient(90deg, #ff9d3f, #ffc178);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 10px;
            font-weight: 700;
            text-shadow: 0 0 20px rgba(255, 157, 63, 0.3);
        }

        .ucl-podium-team {
            font-family: 'Playfair Display', serif;
            font-size: 2em;
            font-weight: 900;
            background: linear-gradient(135deg, #ff9d3f, #ffc178, #ffe0b3);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-top: 10px;
            filter: drop-shadow(0 0 10px rgba(255, 157, 63, 0.4));
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .ucl-stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
            position: relative;
            z-index: 2;
        }

        .ucl-stat-row {
            background: linear-gradient(135deg, rgba(255, 157, 63, 0.12), rgba(209, 38, 61, 0.08));
            border-left: 4px solid;
            border-image: linear-gradient(180deg, #ff9d3f, #d1263d) 1;
            padding: 20px;
            border-radius: 10px;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            row-gap: 8px;
            column-gap: 16px;
            animation: slideIn 0.5s ease forwards;
            position: relative;
            overflow: visible;
            box-shadow: 0 0 15px rgba(255, 157, 63, 0.15),
                        inset 0 0 10px rgba(255, 157, 63, 0.05);
            transition: all 0.3s ease;
        }

        .ucl-stat-row:hover {
            box-shadow: 0 0 25px rgba(255, 157, 63, 0.3),
                        inset 0 0 15px rgba(255, 157, 63, 0.1);
            transform: translateX(5px);
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .ucl-stat-key {
            color: #ff9d3f;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.85em;
            letter-spacing: 1.5px;
            background: linear-gradient(90deg, #ff9d3f, #ffc178);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            filter: drop-shadow(0 0 5px rgba(255, 157, 63, 0.3));
            flex: 0 0 auto;
            min-width: 0;
        }

        .ucl-stat-val {
            color: #ffe0b3;
            font-weight: 800;
            font-size: 1.1em;
            background: linear-gradient(90deg, #ffc178, #ffe0b3);
            -webkit-background-clip: text;
            background-clip: text;
