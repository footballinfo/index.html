        // ===== UCL SEARCH FUNCTIONALITY =====
        function performUCLSearch() {
            const searchInput = document.getElementById('uclSearchInput');
            const searchTerm = searchInput.value.toLowerCase().trim();
            const searchResults = document.getElementById('uclSearchResults');

            if (!searchTerm) {
                searchResults.innerHTML = '<div class="ucl-no-results">Enter a season or team name to search...</div>';
                return;
            }

            // normalize helper: strips punctuation/diacritics-ish noise and collapses spacing,
            // and expands a few very common club nicknames/abbreviations so real-world searches
            // like "psg", "man utd" or "barca" actually match the full club names below.
            const ALIASES = {
                "psg": "paris saint-germain",
                "man utd": "manchester united",
                "man united": "manchester united",
                "man city": "manchester city",
                "barca": "fc barcelona",
                "barcelona": "fc barcelona",
                "real": "real madrid",
                "inter": "inter milan",
                "bayern": "bayern munich",
                "milan": "ac milan",
                "juve": "juventus",
                "dortmund": "borussia dortmund",
                "atletico": "atlético madrid",
                "atleti": "atlético madrid"
            };

            function normalize(str) {
                return str.toLowerCase().trim();
            }

            const normalizedTerm = normalize(searchTerm);
            const expandedTerm = ALIASES[normalizedTerm] || normalizedTerm;

            const filtered = UCL_DATA.filter(d => {
                const season = normalize(d.season);
                const winner = normalize(d.winner);
                const runnerup = normalize(d.runnerup);
                return season.includes(normalizedTerm) ||
                       winner.includes(normalizedTerm) ||
                       runnerup.includes(normalizedTerm) ||
                       winner.includes(expandedTerm) ||
                       runnerup.includes(expandedTerm);
            });

            if (filtered.length === 0) {
                searchResults.innerHTML = '<div class="ucl-no-results">No tournaments found. Try searching for a different season or team!</div>';
                return;
            }

            searchResults.innerHTML = filtered.map((d) => `
                <div class="ucl-result-card" onclick="selectUCLYear(${UCL_DATA.indexOf(d)})">
                    <div class="ucl-result-year">${d.season}</div>
                    <div class="ucl-result-info">
                        <div class="ucl-result-row">
                            <span class="ucl-result-label">🏆 Champion</span>
                            <span class="ucl-result-value">${d.winner}</span>
                        </div>
                        <div class="ucl-result-row">
                            <span class="ucl-result-label">🥈 Runner-up</span>
                            <span class="ucl-result-value">${d.runnerup}</span>
                        </div>
                        <div class="ucl-result-row">
                            <span class="ucl-result-label">⚽ Top Scorer</span>
                            <span class="ucl-result-value">${d.topScorer}</span>
                        </div>
                    </div>
                </div>
            `).join('');

            // Scroll to results
            setTimeout(() => {
                searchResults.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
        }

